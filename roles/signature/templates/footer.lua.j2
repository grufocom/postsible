-- /etc/rspamd/plugins.d/footer.lua
-- Managed by Ansible (roles/signature) — do not edit manually.
--
-- Appends per-user or per-domain HTML/plain-text signatures to outbound mail.
-- Runs as a prefilter at priority 10 — executes BEFORE DKIM signing so that
-- body hashes remain valid at the recipient's end.
--
-- Signature file locations:
--   Per-user:   {{ signature_base_dir }}/users/<email>/signature.{html,txt}
--   Per-domain: {{ signature_base_dir }}/domains/<domain>/signature.{html,txt}

local rspamd_logger = require "rspamd_logger"
local lua_mime      = require "lua_mime"
local rspamd_text   = require "rspamd_text"

rspamd_logger.warnx("footer: loading version - skip problematic encodings")

local function get_mail_charset(task)
    local content_type = task:get_header('Content-Type') or ''
    local charset = content_type:match('charset="?([^";]+)"?')
    if charset then
        return charset:lower()
    end
    return 'utf-8'
end

local function get_content_transfer_encoding(task)
    local cte = task:get_header('Content-Transfer-Encoding') or ''
    return cte:lower()
end

-- Skip signatures for problematic charset/encoding combinations
local function should_skip_signature(charset, encoding)
    -- Skip US-ASCII charsets
    local ascii_charsets = {
        ['us-ascii'] = true,
        ['ascii'] = true,
        ['ansi_x3.4-1968'] = true,
        ['iso-8859-1'] = true,
        ['iso8859-1'] = true,
        ['latin1'] = true,
    }

    if ascii_charsets[charset] then
        return true, "charset is " .. charset
    end

    -- Skip base64 encoded mails (would break structure)
    if encoding == 'base64' then
        return true, "encoding is base64"
    end

    -- Skip quoted-printable if charset is not utf-8
    if encoding == 'quoted-printable' and charset ~= 'utf-8' then
        return true, "quoted-printable with non-UTF-8 charset"
    end

    return false, nil
end

local function read_signature_from_path(base_dir, identifier)
    local html_content, txt_content = nil, nil
    local f

    f = io.open(base_dir .. "/signature.html", "r")
    if f then
        html_content = f:read("*all")
        f:close()
    end

    f = io.open(base_dir .. "/signature.txt", "r")
    if f then
        txt_content = f:read("*all")
        f:close()
    end

    return html_content, txt_content
end

local function get_user_domain(email)
    local at_pos = email and email:find("@")
    if at_pos then
        return email:sub(at_pos + 1)
    end
    return nil
end

local function get_signature(user_email)
    if not user_email then
        return nil, nil
    end

    -- 1. Try user signature
    local user_path = "{{ signature_base_dir }}/users/" .. user_email
    local html, txt = read_signature_from_path(user_path)
    if html or txt then
        rspamd_logger.infox("footer: found user signature for %s", user_email)
        return html, txt
    end

    -- 2. Try domain signature
    local domain = get_user_domain(user_email)
    if domain then
        local domain_path = "{{ signature_base_dir }}/domains/" .. domain
        html, txt = read_signature_from_path(domain_path)
        if html or txt then
            rspamd_logger.infox("footer: found domain signature for %s (%s)", user_email, domain)
            return html, txt
        end
    end

    return nil, nil
end

local function footer_callback(task)
    local user = task:get_user()
    if not user then
        return false
    end

    -- Check charset and encoding FIRST
    local charset = get_mail_charset(task)
    local encoding = get_content_transfer_encoding(task)

    local skip, reason = should_skip_signature(charset, encoding)

    if skip then
        rspamd_logger.infox(task, "footer: skipping signature - %s (charset=%s, encoding=%s)",
            reason, charset, encoding)
        return false
    end

    local footer_html, footer_plain = get_signature(user)
    if not footer_html and not footer_plain then
        return false
    end

    rspamd_logger.infox(task, "footer: appending signature for %s (charset=%s, encoding=%s)",
        user, charset, encoding)

    local rewrite = lua_mime.add_text_footer(task, footer_html, footer_plain)
    if not rewrite or not rewrite.out then
        rspamd_logger.warnx(task, "footer: add_text_footer failed for %s", user)
        return false
    end

    local new_ct_value, new_cte_value
    if rewrite.need_rewrite_ct then
        if rewrite.new_ct then
            new_ct_value = string.format('%s/%s; charset=utf-8',
                rewrite.new_ct.type, rewrite.new_ct.subtype)
        end
        if rewrite.new_cte then
            new_cte_value = rewrite.new_cte
        end
    end

    local parts = {}
    local nl = (task:get_newlines_type() == 'lf') and '\n' or '\r\n'

    task:headers_foreach(function(name, hdr)
        local lname = name:lower()
        if lname == 'content-length' then
            return
        elseif lname == 'content-type' and new_ct_value then
            parts[#parts + 1] = rspamd_text.fromstring(
                'Content-Type: ' .. new_ct_value .. nl)
        elseif lname == 'content-transfer-encoding' and new_cte_value then
            parts[#parts + 1] = rspamd_text.fromstring(
                'Content-Transfer-Encoding: ' .. new_cte_value .. nl)
        else
            parts[#parts + 1] = rspamd_text.fromstring(hdr.raw)
        end
    end, {full = true})

    parts[#parts + 1] = rspamd_text.fromstring(nl)

    for _, o in ipairs(rewrite.out) do
        if type(o) == 'table' then
            local data = o[1]
            if type(data) == 'userdata' then
                parts[#parts + 1] = data
            elseif type(data) == 'string' then
                parts[#parts + 1] = rspamd_text.fromstring(data)
            end
            parts[#parts + 1] = rspamd_text.fromstring(nl)
        elseif type(o) == 'userdata' then
            parts[#parts + 1] = o
            parts[#parts + 1] = rspamd_text.fromstring(nl)
        elseif type(o) == 'string' then
            if o == '' then
                parts[#parts + 1] = rspamd_text.fromstring(nl)
            else
                parts[#parts + 1] = rspamd_text.fromstring(o)
                parts[#parts + 1] = rspamd_text.fromstring(nl)
            end
        end
    end

    local ok, err = pcall(function()
        task:set_message(rspamd_text.fromtable(parts))
    end)

    if ok then
        rspamd_logger.infox(task, "footer: success for %s", user)
        return true
    else
        rspamd_logger.warnx(task, "footer: set_message error for %s: %s",
            user, tostring(err))
        return false
    end
end

rspamd_config:register_symbol({
    name     = 'FOOTER',
    type     = 'prefilter',
    callback = footer_callback,
    priority = 10,
})

rspamd_logger.warnx("footer: version with problematic encoding skip registered")
